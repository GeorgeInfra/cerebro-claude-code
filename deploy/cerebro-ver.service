[Unit]
Description=Cerebro compartilhado (pagina /ver)
After=network-online.target
[Service]
EnvironmentFile=/opt/cerebro-mcp/.env
Environment=CEREBRO_MCP_DIR=/opt/cerebro-mcp
WorkingDirectory=/opt/cerebro-ver
ExecStart=/opt/cerebro-mcp/venv/bin/python ver.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
