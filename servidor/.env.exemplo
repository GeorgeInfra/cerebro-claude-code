# Copie para /opt/cerebro-mcp/.env (permissão 600) e preencha.
# Seu nome: aparece nas instruções que as IAs leem e no título da página.
CEREBRO_DONO="Seu Nome"
# Pasta das notas (repositório git). O instalar.sh cria a partir de notas-iniciais/.
CEREBRO_RAIZ=/root/cerebro
# Fuso das datas do diário, em horas (Brasília = -3).
CEREBRO_FUSO=-3
# Portas locais (o Caddy publica com HTTPS). Só mude se já estiverem em uso.
CEREBRO_PORTA=8765
CEREBRO_PORTA_VER=8766

# Opcional: avisos de segurança no Telegram (token inválido, login na página, token criado/revogado).
# Crie um bot com o @BotFather e mande uma mensagem para ele; o chat id aparece em
# https://api.telegram.org/bot<TOKEN>/getUpdates. Deixe vazio para desligar.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
